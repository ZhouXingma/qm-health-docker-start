# 复制为 .env 后按需修改；.env 不要提交

# ---------- 镜像版本 ----------
# 取值就是镜像 tag：可以写精确版本（16.3）、主版本（16）、变体（16-alpine）或 latest
POSTGRES_VERSION=16.3
REDIS_VERSION=8.6.0
# 两个应用各自独立指定，互不影响
# qm-health-rust：latest / main / sha-xxxxxxxx
RUST_VERSION=latest
# qm-health-ai：latest / main / sha-xxxxxxxx
# 注意这是私有包，拉取前需 docker login ghcr.io
AI_VERSION=latest
# 建议固定到 sha- 开头的不可变 tag，回退版本时行为可预期

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=books123
# 要与 envs/.env.* 里 db.url 的 .../qm_health 一致
POSTGRES_DB=qm_health
POSTGRES_PORT=5432

# ---------- Redis ----------
# 密码与 postgres 相同
REDIS_PASSWORD=books123
REDIS_PORT=6379

# ---------- qm-health-rust ----------
# 宿主机映射端口（容器内固定 8080）
RUST_PORT=8080
# 日志级别：warn（默认）/ info / debug，本地调试建议 info
RUST_LOG_LEVEL=info

# ---------- qm-health-ai ----------
# 宿主机映射端口（容器内固定 8082）
AI_PORT=8082
# 日志级别：info（默认）/ debug
AI_LOG_LEVEL=info
# 该服务用的 Redis 库号，默认 1（与 rust 的 ADMIN_REDIS_DB 同库）
AI_REDIS_DB=1
# rust 服务地址，ai 启动时从这里拉 MCP 工具列表
# 默认已指向同一网络内的 rust 服务（容器名），一般不用改
# QMHEALTH_URL=http://qm-health-rust:8080
# 浏览器访问 rust 的地址，由 ai 通过 GET /app-config.js 下发给前端
# （前端登录页 / 指标页据此调 rust 的 /admin/* 接口）。
# 必须是从「浏览器所在机器」能访问到的地址——容器名浏览器解析不了，所以不能填
# qm-health-rust。默认 localhost 适用于本机浏览器；若从其它机器访问前端，
# 改成宿主机的局域网 IP，例如 http://192.168.1.10:8080
RUST_PUBLIC_URL=http://localhost:8080
# ai 请求 rust 的签名密钥，rust 用 sys_app.security_key 校验签名。
# 不填则用镜像内置的测试密钥（与 02-seed.sql 里 sys_app(app_code='qmhealth_ai')
# .security_key 的内置值相同）。要自定义需同时改两处，且值一致：
#   1) 02-seed.sql 里 sys_app 的 security_key（已建库则直接 UPDATE 那行）
#   2) 这里填一个非空值，并在 compose.yaml 里取消 QMHEALTH_SECURITY_KEY 那行注释
# 与 rust 的 ENCRYPTION_KEY 无关，不用同步改
# QMHEALTH_SECURITY_KEY=

# ---------- 通用 ----------
TZ=Asia/Shanghai

# ---------- 数据 ----------
# Postgres 与 Redis 的数据都在命名卷 qm_health 里，用子目录区分：
#   pgdata/  -> PostgreSQL
#   redis/   -> Redis
# 应用数据各用独立卷：
#   qm_health_rust_data  -> rust 的 /data（logs + files）
#   qm_health_ai_data    -> ai 的 /data/logs/qm-health-ai
# 不需要在这里配置宿主机路径，卷由 docker 管理。
